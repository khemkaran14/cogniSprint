# Base URL of the Express API. Leave unset in local dev — Vite's dev server
# proxies /api/* to http://localhost:4000 (see vite.config.ts). Set this only
# when the client and server are deployed to different origins in production.
VITE_API_URL=

# Public site URL, used for canonical links and share URLs.
VITE_APP_URL=https://cognisprint.divyrs.com
