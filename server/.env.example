PORT=4000
CLIENT_URL=http://localhost:5173
# Set to "production" in deployed environments — this makes the auth
# session cookie "secure" (HTTPS-only). Leave unset for local HTTP dev.
NODE_ENV=

# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://localhost:27017/cognisprint

# Signs auth session JWTs. Generate a real random value before deploying,
# e.g. `openssl rand -base64 32` — never reuse this example value.
AUTH_SECRET=

# Razorpay. Leave unset to exercise the app's honest "payment isn't
# connected yet" state instead of a live checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend transactional email. Leave unset to log emails to the server
# console instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=CogniSprint <hello@cognisprint.com>
SUPPORT_EMAIL=support@cognisprint.com
