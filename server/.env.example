# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ai_career_shield

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# First admin account, created automatically by the seed script
ADMIN_EMAIL=admin@aicareershield.com
ADMIN_PASSWORD=change-this-password
