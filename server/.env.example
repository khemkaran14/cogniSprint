PORT=4000
CLIENT_URL=http://localhost:5173
# Comma-separated origins are supported for preview/production clients.
# COOKIE_DOMAIN=.cognisprint.com
# COOKIE_SAME_SITE=lax
NODE_ENV=development
# Keep false until the reviewed launch package and external launch gates are complete.
ENROLLMENT_OPEN=false
PRIVACY_RETENTION_POLICY_VERSION=

# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://localhost:27017/cognisprint
# Atlas example (replace every placeholder and URL-encode special password characters):
# MONGODB_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@cluster.example.net/cognisprint?retryWrites=true&w=majority

# Razorpay. Leave unset to exercise the app's honest "payment isn't
# connected yet" state instead of a live checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend transactional email. Leave unset to log emails to the server
# console instead of sending them.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=CogniSprint <hello@cognisprint.com>
SUPPORT_EMAIL=support@cognisprint.com

# Optional centralized JSON log/error collector. HTTPS is required in production.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
LOG_SERVICE=cognisprint-api
LOG_ENVIRONMENT=development

# Only required when running the post-deploy smoke test (server/src/ops/smoke.ts),
# e.g. via the staging-smoke.yml workflow. Not needed for local development.
# API_URL=https://staging-api.cognisprint.com
# APP_URL=https://staging.cognisprint.com
